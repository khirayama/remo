    "test": "vitest run",
    "deploy": "npm run build:production && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
