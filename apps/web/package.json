{
  "name": "@remo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode development",
    "build:production": "vite build --mode production",
    "preview": "npm run build && wrangler dev",
