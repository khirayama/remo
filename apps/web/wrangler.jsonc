{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "3be94fe02250b737f7a9dcec19a3be39",
  "name": "remo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API requests reach the Worker; static files are served directly.
    "run_worker_first": ["/api/*"]
  },
  // The production API worker (apps/api, env "production").
  "services": [{ "binding": "API", "service": "remo-api" }]
}
