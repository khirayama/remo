<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device transfer. The timeline database is kept so a
  new phone restores its records. Excluded: the session token (encrypted with
  a Keystore key that never leaves this device), per-account sync state, and
  data that is either device-specific or rebuilt from the records.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="rem_auth.xml" />
        <exclude domain="sharedpref" path="rem_sync.xml" />
        <exclude domain="database" path="rem_photo_index.db" />
        <exclude domain="file" path="stay-index.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rem_auth.xml" />
        <exclude domain="sharedpref" path="rem_sync.xml" />
        <exclude domain="database" path="rem_photo_index.db" />
        <exclude domain="file" path="stay-index.json" />
    </device-transfer>
</data-extraction-rules>
